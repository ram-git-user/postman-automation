    },
    {
      "key": "issuanceOtpHost",
      "value": "http://192.168.10.35:9744"
    },
    {
      "key": "verifyOtpHost",
      "value": "http://192.168.10.35:9744"
    },
    {
      "key": "otp",
      "value": ""
    }
  ]
}